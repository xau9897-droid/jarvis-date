<%- include('partials/header') %>
<div class="edit-profile-container">
  <h1 class="page-title">Edit Profile</h1>
  <% if (error) { %>
    <div class="error-msg"><%= error %></div>
  <% } %>
  <form action="/profile/edit" method="POST" enctype="multipart/form-data" class="edit-profile-form">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name" value="<%= profile.name %>" required>
    </div>
    <div class="form-group">
      <label for="age">Age</label>
      <input type="number" id="age" name="age" value="<%= profile.age || '' %>" min="18" max="120">
    </div>
    <div class="form-group">
      <label for="gender">Gender</label>
      <select id="gender" name="gender">
        <option value="male" <%= profile.gender === 'male' ? 'selected' : '' %>>Male</option>
        <option value="female" <%= profile.gender === 'female' ? 'selected' : '' %>>Female</option>
        <option value="other" <%= profile.gender === 'other' ? 'selected' : '' %>>Other</option>
      </select>
    </div>
    <div class="form-group">
      <label for="interested_in">Interested In</label>
      <select id="interested_in" name="interested_in">
        <option value="male" <%= profile.interested_in === 'male' ? 'selected' : '' %>>Men</option>
        <option value="female" <%= profile.interested_in === 'female' ? 'selected' : '' %>>Women</option>
        <option value="all" <%= !profile.interested_in || profile.interested_in === 'all' ? 'selected' : '' %>>Everyone</option>
      </select>
    </div>
    <div class="form-group">
      <label for="location">Location</label>
      <input type="text" id="location" name="location" value="<%= profile.location || '' %>" placeholder="City, Country">
    </div>
    <div class="form-group">
      <label for="bio">About Me</label>
      <textarea id="bio" name="bio" rows="4" placeholder="Tell people about yourself..."><%= profile.bio || '' %></textarea>
    </div>
    <div class="form-group">
      <label for="photo">Profile Photo</label>
      <% if (profile.photo) { %>
        <div class="current-photo">
          <img src="/<%= profile.photo %>" alt="Current photo">
        </div>
      <% } %>
      <input type="file" id="photo" name="photo" accept="image/*">
      <input type="hidden" name="current_photo" value="<%= profile.photo || '' %>">
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
  </form>
</div>
<%- include('partials/footer') %>
