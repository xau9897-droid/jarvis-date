<%- include('partials/header') %>
<div class="swiper-container">
  <div class="profile-card" id="profile-card">
    <div class="profile-card-inner" id="profile-inner">
      <div class="card-loading">Loading profiles...</div>
    </div>
  </div>
  <div class="action-buttons" id="action-buttons" style="display:none">
    <button class="action-btn pass-btn" id="pass-btn">
      <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
    </button>
    <button class="action-btn like-btn" id="like-btn">
      <svg viewBox="0 0 24 24" width="30" height="30"><path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
    </button>
  </div>
  <div class="no-more" id="no-more" style="display:none">
    <h2>No more profiles</h2>
    <p>Check back later for new people!</p>
    <a href="/profile/edit" class="btn btn-primary">Update Your Profile</a>
  </div>
</div>
<div id="match-modal" class="match-modal" style="display:none">
  <div class="match-modal-content">
    <h1>It's a Match!</h1>
    <p>You and <span id="match-name"></span> liked each other</p>
    <div class="match-actions">
      <a href="/matches" class="btn btn-primary">Send Message</a>
      <button class="btn btn-secondary" onclick="closeMatch()">Keep Swiping</button>
    </div>
  </div>
</div>
<script>
  const profiles = <%- profiles %>;
</script>
<script src="/js/swiper.js"></script>
<%- include('partials/footer') %>
